generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MessageRole {
  system
  user
  assistant
  tool
}

enum SemanticMemoryCategory {
  preference
  profile
  project_fact
}

enum SemanticMemoryStatus {
  active
  superseded
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  users     User[]
}

model User {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @db.Uuid
  externalId       String
  createdAt        DateTime         @default(now()) @db.Timestamptz(6)
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions         Session[]
  semanticMemories SemanticMemory[]

  @@unique([tenantId, id])
  @@unique([tenantId, externalId])
}

model Session {
  id            String         @default(uuid()) @db.Uuid
  tenantId      String         @db.Uuid
  userId        String         @db.Uuid
  externalId    String?
  expiresAt     DateTime?      @db.Timestamptz(6)
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  user          User           @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  conversations Conversation[]

  @@id([tenantId, userId, id])
  @@unique([tenantId, userId, externalId])
  @@index([tenantId, userId, expiresAt])
}

model Conversation {
  id                       String                @default(uuid()) @db.Uuid
  tenantId                 String                @db.Uuid
  userId                   String                @db.Uuid
  sessionId                String                @db.Uuid
  title                    String?
  nextSequenceNo           Int                   @default(0)
  nextSummaryVersion       Int                   @default(0)
  summaryThroughSequenceNo Int                   @default(0)
  startedAt                DateTime              @default(now()) @db.Timestamptz(6)
  endedAt                  DateTime?             @db.Timestamptz(6)
  session                  Session               @relation(fields: [tenantId, userId, sessionId], references: [tenantId, userId, id], onDelete: Cascade)
  messages                 ConversationMessage[]
  summaries                ConversationSummary[]
  semanticMemories         SemanticMemory[]      @relation("SemanticMemoryConversation")

  @@id([tenantId, id])
  @@unique([tenantId, userId, id])
  @@index([tenantId, userId, startedAt])
  @@index([tenantId, sessionId, startedAt])
}

model ConversationMessage {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @db.Uuid
  conversationId   String           @db.Uuid
  sequenceNo       Int
  role             MessageRole
  content          String           @db.Text
  createdAt        DateTime         @default(now()) @db.Timestamptz(6)
  conversation     Conversation     @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Cascade)
  semanticMemories SemanticMemory[] @relation("SemanticMemorySourceMessage")

  @@unique([tenantId, conversationId, sequenceNo])
  @@unique([tenantId, conversationId, id])
}

model ConversationSummary {
  id                String       @id @default(uuid()) @db.Uuid
  tenantId          String       @db.Uuid
  conversationId    String       @db.Uuid
  version           Int
  summaryText       String       @db.Text
  throughSequenceNo Int
  createdAt         DateTime     @default(now()) @db.Timestamptz(6)
  conversation      Conversation @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, conversationId, version])
  @@index([tenantId, conversationId, throughSequenceNo])
}

model SemanticMemory {
  id                   String                 @id @default(uuid()) @db.Uuid
  tenantId             String                 @db.Uuid
  userId               String                 @db.Uuid
  content              String                 @db.Text
  category             SemanticMemoryCategory
  status               SemanticMemoryStatus   @default(active)
  sourceConversationId String                 @db.Uuid
  sourceMessageId      String                 @db.Uuid
  supersedesMemoryId   String?                @db.Uuid
  createdAt            DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime               @updatedAt @db.Timestamptz(6)
  user                 User                   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  sourceConversation   Conversation           @relation("SemanticMemoryConversation", fields: [tenantId, userId, sourceConversationId], references: [tenantId, userId, id], onDelete: Cascade)
  sourceMessage        ConversationMessage    @relation("SemanticMemorySourceMessage", fields: [tenantId, sourceConversationId, sourceMessageId], references: [tenantId, conversationId, id], onDelete: Cascade)

  @@index([tenantId, userId, status, createdAt])
  @@index([tenantId, sourceConversationId, sourceMessageId])
  @@index([tenantId, userId, supersedesMemoryId])
}
