{
  "name": "recall-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/tests/working-memory.test.js",
    "test:episodic": "tsc -p tsconfig.episodic-test.json && node --test dist-episodic-test/tests/episodic-memory.test.js dist-episodic-test/tests/semantic-memory.test.js dist-episodic-test/tests/semantic-fact-extractor.test.js dist-episodic-test/tests/semantic-memory-extraction-service.test.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose stop postgres",
    "qdrant:up": "docker compose up -d qdrant",
    "qdrant:down": "docker compose stop qdrant",
    "demo": "tsc -p tsconfig.demo.json && node dist-demo/examples/working-memory-demo.js",
    "demo:semantic-extractor": "tsc -p tsconfig.demo.json && node dist-demo/examples/semantic-fact-extraction-demo.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@qdrant/js-client-rest": "^1.20.0",
    "dotenv": "^18.0.10",
    "fastembed": "^3.0.0",
    "gpt-tokenizer": "^4.1.2",
    "groq-sdk": "^1.6.0",
    "pg": "^8.23.1",
    "redis": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.1",
    "typescript": "^5.0.0"
  }
}
